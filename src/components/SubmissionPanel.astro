---
import { withBase } from "astro-theme-university/url";
import { previewNow } from "../data/resource-manifest";

interface Props {
  opens: Date;
  due: Date;
  reportFilename: string;
}

const { opens, due, reportFilename } = Astro.props;
// Same build-time-only RESOURCE_PREVIEW_NOW override resource-manifest.ts
// documents (unset in every normal build, dev server, and deploy) — reused
// here so the download-preview build can also exercise this panel's "open"
// copy, instead of that build always landing on "before-opening" regardless
// of the override.
const now = previewNow() ?? new Date();
// The static site distinguishes only "before opening" (schedule-driven) from
// "open" — it never renders "To be submitted" or "Submitted" itself, since
// only the authenticated portal knows whether *this* student has an attempt
// recorded. See docs/CONTENT_SOURCE.md's "Submission panels" section: "the
// public site must not guess or simulate a student's submission status."
const state: "before-opening" | "open" = now < opens ? "before-opening" : "open";

const withTime = new Intl.DateTimeFormat("en-AU", {
  dateStyle: "long",
  timeStyle: "short",
  timeZone: "Australia/Sydney",
});
---

<section class="submission-panel" aria-labelledby="submission-heading" data-submission-state={state}>
  <h2 id="submission-heading">Submission</h2>

  {
    state === "before-opening" ? (
      <p class="submission-panel__status">Will be available at {withTime.format(opens)} AET.</p>
    ) : (
      <p class="submission-panel__status">
        Submission is open. Your current submission status is shown in the authenticated SlopU
        Submission Portal.
      </p>
    )
  }

  <h3 id="submission-heading__checklist">Required submission</h3>
  <p>
    Upload <code>{reportFilename}</code> and enter the final GitLab commit SHA. Your name and
    student ID must appear on the report's first page. The frozen commit's{" "}
    <code>submission-manifest.json</code> identifies the exact private Hugging Face model
    revision used for marking.
  </p>
  <p>
    <strong>Never paste a Hugging Face access token into the course site, portal, report,
    repository, or model package.</strong> Marker access is granted through the SlopU
    Hugging Face organisation.
  </p>
  <p><strong>Due:</strong> {withTime.format(due)} AET</p>

  <p class="submission-panel__actions">
    <span class="at-button submission-panel__pending" aria-disabled="true">
      Open SlopU Submission Portal
    </span>
    <a class="at-button at-button--outline" href={withBase("/policies/")}>Review the submission checklist</a>
  </p>
  <p class="submission-panel__note">
    The authenticated SlopU Submission Portal is a separate system, provisioned by the teaching
    team closer to each project's opening date. This page will link to it directly once it exists;
    it does not upload work or collect credentials. Once provisioned, the portal itself shows{" "}
    <code>To be submitted</code> until you have a recorded attempt, and <code>Submitted</code>{" "}
    afterwards — this static page never guesses or simulates that personal status.
  </p>
</section>

<style>
  .submission-panel__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .submission-panel__pending {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .submission-panel__note {
    font-size: 0.9rem;
    color: var(--at-text-secondary);
  }
</style>
