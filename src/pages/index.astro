---
import { getImage } from "astro:assets";
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import PeopleGrid from "../components/PeopleGrid.astro";
import heroImage from "../assets/images/hero-home-threads.png";
import bgCircuitBoard from "../assets/images/bg-circuit-board.jpg";
import bgServerRoom from "../assets/images/bg-server-room.jpg";
import bgPcbMacro from "../assets/images/bg-pcb-macro.jpg";
import { courseMeta } from "../course-config";
import { siteConfig } from "../site-config";
import { getWeeklySchedule } from "../data/weekly-schedule";
import { formatCourseDeadline, formatWeekBeginning } from "../lib/dates";

const { weeks, projects } = await getWeeklySchedule();

// One decorative photo per project stage (Unsplash License: free to use, no
// attribution required), reused across both the three stage cards and their
// twelve associated week cards. Resized here via getImage rather than a raw
// src="..." import so the same 1400px-wide originals aren't shipped at full
// size for what's only ever shown as a low-opacity card backdrop.
const stageBackgrounds = {
  1: await getImage({ src: bgCircuitBoard, width: 800, format: "webp" }),
  2: await getImage({ src: bgServerRoom, width: 800, format: "webp" }),
  3: await getImage({ src: bgPcbMacro, width: 800, format: "webp" }),
} as const;

// Home-only editorial framing for each project stage, approved verbatim from
// the "The course in three stages" section of docs/CONTENT_SOURCE.md. Weekly
// facts (lecture/session/deadline) come from the shared weekly-schedule
// registry above; this is prose that has no equivalent in a content
// collection, so it stays local to the page that renders it.
const stageCopy: Record<1 | 2 | 3, { heading: string; purpose: string }> = {
  1: {
    heading: "1. Build language ability",
    purpose:
      "Pre-train a decoder-only Transformer on a supplied narrative corpus. Decide how model " +
      "capacity, tokenization, data, optimisation, and runtime fit together under a " +
      "32M-parameter design target.",
  },
  2: {
    heading: "2. Shape model behaviour",
    purpose:
      "Start from a narrative checkpoint and give the model a recognisable voice. Compare " +
      "continued pre-training, supervised instruction tuning, preference-based methods, or a " +
      "justified combination without hiding regressions behind one improved metric.",
  },
  3: {
    heading: "3. Build a specialist",
    purpose:
      "Adapt a permitted checkpoint for one measurable function. Choose a bounded narrative " +
      "capability or arithmetic reasoning, test generalisation, and determine what the " +
      "intervention changed as well as what it damaged.",
  },
};

const weekGroups = [
  { stage: 1 as const, label: "Weeks 1–4", weeks: weeks.slice(0, 4) },
  { stage: 2 as const, label: "Weeks 5–8", weeks: weeks.slice(4, 8) },
  { stage: 3 as const, label: "Weeks 9–12", weeks: weeks.slice(8, 12) },
];
---

<ContentLayout
  title={courseMeta.title}
  description={`Hands-on frontier practice to perceive language model training & fine tuning:\nIt is a Budgeted Engineering Task.`}
  heroImage={heroImage}
  heroImageAlt="An original 3D rendering of a wide bank of translucent, server-rack-like panels linked by glowing gold threads, narrowing from a wide token input on the left to a compact output stack on the right."
  {...siteConfig}
>
  <p class="course-label">{courseMeta.code} · {courseMeta.session}, {courseMeta.year}</p>

  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <p class="hero-lead">
    Most language-model courses begin after the expensive decisions have
    already been made. This course begins before the first training token.
    You will choose how to spend a limited model and compute budget, build a
    narrative language model from scratch, reshape its behaviour through
    post-training, and adapt it for one bounded specialist task.
  </p>
  <p>
    The objective is not to imitate a frontier model at miniature scale. It
    is to learn which claims survive contact with limited parameters,
    limited data, limited compute, and evidence you must be able to defend.
  </p>

  <div class="intro-grid">
    <section>
      <h2>What you will do</h2>
      <p>
        Work through three connected projects that follow the life of a language model. You will
        pre-train a narrative model from scratch, reshape its behaviour through post-training, and
        adapt a permitted checkpoint for one specialist capability. At every stage, you will make
        choices about the model, data, training budget, and evaluation—and use evidence to decide
        whether those choices worked.
      </p>
    </section>
    <section>
      <h2>Who this is for</h2>
      <p>
        This course is for senior undergraduate and postgraduate students who have ever wondered
        what actually happens inside the training run behind a language model, and want to stop
        taking that on faith. It suits anyone who enjoys turning a vague claim about scale, data,
        or alignment into an experiment they can run and defend with evidence, and who would
        rather make one deliberate training decision than run a large search and hope.
      </p>
      <p>
        By the end, you will have trained a real language model of your own from scratch, reshaped
        its behaviour on purpose, and specialised it for a task you chose — and be able to explain,
        with evidence, why each of those choices worked or didn't.
      </p>
      <p>
        You should have completed introductory machine learning and be comfortable with basic
        Python, linear algebra, and probability. Prior experience with PyTorch, GPUs, or training a
        language model is not required — the supported sessions and starter repositories introduce
        the working pipeline before you depend on it in an assessment.
      </p>
    </section>
  </div>

  <h2>The course in three stages</h2>
  <div
    style={{
      "--stage1BgImage": `url(${stageBackgrounds[1].src})`,
      "--stage2BgImage": `url(${stageBackgrounds[2].src})`,
      "--stage3BgImage": `url(${stageBackgrounds[3].src})`,
    }}
  >
    <CardGrid columns={3}>
      {
        projects.map((project) => (
          <Card title={stageCopy[project.project].heading} href={project.href} headingLevel="h3">
            <p>{stageCopy[project.project].purpose}</p>
            <p>
              <strong>Project {project.project}:</strong> {project.title.replace(/^Project \d+ — /, "")}
              {" "}· Weeks {project.weeks[0]}–{project.weeks[1]} · {project.weight}% · due{" "}
              {formatCourseDeadline(project.due)}
            </p>
          </Card>
        ))
      }
    </CardGrid>
  </div>

  <p class="hero-ctas">
    <a class="at-button" href={withBase("/lectures/week-01/")}>Start with Week 1</a>
    <a class="at-button at-button--outline" href={withBase("/assessments/")}>View the three projects</a>
  </p>

  <h2>Your twelve-week path</h2>
  <p>
    Each week connects one lecture, one practical or support session, and the next decision in the
    current project. Open either activity directly and use <strong>this week</strong> as the
    minimum project checkpoint to reach before moving on.
  </p>

  {
    weekGroups.map((group) => (
      <>
        <h3>{group.label}</h3>
        <div class="week-grid" style={{ "--card-bg-image": `url(${stageBackgrounds[group.stage].src})` }}>
          {group.weeks.map((entry) => (
            <>
              <article class="week-card">
                <h4>
                  Week {entry.week} · {formatWeekBeginning(entry.weekBeginning)}
                </h4>
                {entry.lecture && (
                  <p>
                    <span class="week-card__label">Lecture:</span>{" "}
                    <a href={withBase(entry.lecture.href)}>{entry.lecture.title}</a>
                  </p>
                )}
                {entry.session && (
                  <p>
                    <span class="week-card__label">{entry.session.typeLabel}:</span>{" "}
                    <a href={withBase(entry.session.href)}>{entry.session.title}</a>
                  </p>
                )}
                {entry.milestone ? (
                  <p>
                    <span class="week-card__label">This week:</span>{" "}
                    <a href={withBase(entry.milestone.href)}>
                      <strong>{entry.actionText}</strong>
                    </a>
                  </p>
                ) : (
                  <p>
                    <span class="week-card__label">This week:</span> {entry.actionText}
                  </p>
                )}
              </article>
              {entry.week === 6 && (
                <p class="mid-break">
                  <strong>Mid-semester break, Monday 5–Sunday 11 April 2027</strong> — no teaching.
                  Preserve logs and checkpoints outside the runtime.
                </p>
              )}
            </>
          ))}
        </div>
      </>
    ))
  }

  <p class="hero-ctas">
    <a class="at-button at-button--outline" href={withBase("/schedule/")}>Open the full schedule</a>
  </p>

  <h2>What you will learn to do</h2>
  <p>By the end of the course, you should be able to:</p>
  <ol>
    <li>
      explain and critically evaluate current language-model architectures,
      data practices, training stages, efficiency techniques, and emerging
      claims;
    </li>
    <li>
      plan model capacity, data, optimisation, compute, time, and evaluation
      as one constrained engineering system;
    </li>
    <li>
      run controlled experiments, inspect quantitative results and
      qualitative failures, and revise a plan when the evidence requires it;
      and
    </li>
    <li>
      transfer ideas from frontier systems into small-scale experiments
      while identifying what may not transfer across scale.
    </li>
  </ol>

  <h2>One budget, not unlimited search</h2>
  <p>
    Every project has a learned-parameter boundary and two cumulative
    compute ceilings. Pilots, ablations, failed training runs, and final
    runs all count. The constraint is part of the subject: strong work
    chooses informative experiments, preserves evidence, and stops when
    another run would not answer a useful question.
  </p>
  <p>
    The course provides working starter repositories, versioned data, Colab
    notebooks, evaluation packs, and course-managed fallback compute. Prior
    experience training an LLM or using a GPU is not required;
    introductory machine learning, basic Python, and willingness to inspect
    PyTorch code are expected.
  </p>

  <h2>Assessment timeline</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">Teaching block</th>
          <th scope="col">Project</th>
          <th scope="col">Weight</th>
          <th scope="col">Deadline</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Weeks 1–4 · Pre-training</td>
          <td>Project 1 — Build a Narrative Base Model</td>
          <td>20%</td>
          <td>Sunday 21 March 2027, 23:59 AET</td>
        </tr>
        <tr>
          <td>Weeks 5–8 · Post-training</td>
          <td>Project 2 — Give the Model a Voice</td>
          <td>50%</td>
          <td>Sunday 25 April 2027, 23:59 AET</td>
        </tr>
        <tr>
          <td>Weeks 9–12 · Specialisation</td>
          <td>Project 3 — Build a Specialist</td>
          <td>30%</td>
          <td>Sunday 23 May 2027, 23:59 AET</td>
        </tr>
        <tr>
          <td></td>
          <td><strong>Total</strong></td>
          <td><strong>100%</strong></td>
          <td></td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2>Meet your teaching team</h2>
  <p>
    Three roles carry deliberately different responsibilities: the convenor
    for course concepts and assessment design, a teaching fellow for
    implementation questions, and a compute steward for platform and budget
    issues. Open a card for a teacher's full profile and contact details.
  </p>
  <PeopleGrid />
  <p class="hero-ctas">
    <a class="at-button at-button--outline" href={withBase("/people/")}>View the full People page</a>
  </p>

  <h2>How the course works</h2>
  <ul>
    <li><strong>Lectures</strong> connect mechanisms, public evidence, and the decisions students must make at 32M scale.</li>
    <li>
      <strong>Labs</strong> run in Weeks 2, 6, and 10. Each turns a central
      mechanism into a bounded, carefully supported exercise: read it, run
      it, inspect it, change one thing, and transfer the result into the
      current project.
    </li>
    <li>
      <strong>Drop-in clinics</strong> run in Weeks 3, 7, and 11. Bring
      evidence from your own project: a configuration, curve, comparison,
      output pair, failed command, or proposed claim. Clinics help you
      diagnose and decide; they do not choose an assessed method for you.
    </li>
    <li>
      <strong>Guided sessions</strong> run in the remaining six teaching
      weeks. These short launch, validation, evaluation, and packaging
      activities connect the lecture, lab, and project without creating
      extra graded work.
    </li>
    <li>
      <strong>Projects</strong> assess the resulting engineering judgement
      through a reproducible report and a frozen submitted checkpoint.
    </li>
    <li>
      <strong>Frontier Notes</strong> occasionally introduce a relevant new
      paper or model report. They are optional and are never silently added
      to assessed prerequisite knowledge.
    </li>
  </ul>

  <h2>Where to go next</h2>
  <p>
    Training begins with the target, not the training loop. In Week 1, you
    will turn story text into token targets and make the first decision
    that affects every later result.
  </p>
  <p class="hero-ctas">
    <a class="at-button" href={withBase("/lectures/week-01/")}>Open Week 1 — What a Language Model Learns</a>
  </p>
  <CardGrid columns={3}>
    <Card title="Schedule" href="/schedule/">
      <p>One chronological view of lectures, weekly sessions, and project milestones.</p>
    </Card>
    <Card title="Assessments" href="/assessments/">
      <p>The three project briefs, rubrics, resources, and due dates.</p>
    </Card>
    <Card title="Policies" href="/policies/">
      <p>Rules covering compute, data, evaluation, submission, support, and privacy.</p>
    </Card>
  </CardGrid>
</ContentLayout>

<script>
  // ContentLayout renders `description` as plain text inside `.lead`, and
  // the course label (`p.course-label` below) is likewise plain text ---
  // neither admits markup, so the per-letter flicker is built here by
  // re-splitting each element's already-rendered text into spans, client-side,
  // rather than by changing the theme component. Runs on first load and again
  // after every ClientRouter view-transition navigation (`astro:page-load`
  // fires for both), since a module script only executes once per swap
  // otherwise.
  function flickerize(el: HTMLElement | null) {
    if (!el || el.dataset.flickerReady) return;
    el.dataset.flickerReady = "true";

    const text = el.textContent ?? "";

    const accessibleText = document.createElement("span");
    accessibleText.className = "visually-hidden";
    accessibleText.textContent = text;

    const decorative = document.createElement("span");
    decorative.setAttribute("aria-hidden", "true");

    // Split into words (keeping the space/newline separators) rather than
    // appending every letter span as a direct sibling --- adjacent
    // inline-block letters with nothing but element boundaries between them
    // are each their own break opportunity to Chromium, which otherwise
    // wraps mid-word at narrow viewports. Grouping a word's letters inside
    // one inline-block span keeps the word atomic, the same way a plain text
    // word never breaks internally.
    for (const segment of text.split(/(\n| )/)) {
      if (segment === "") continue;
      if (segment === "\n" || segment === " ") {
        decorative.append(document.createTextNode(segment));
        continue;
      }
      const word = document.createElement("span");
      word.className = "flicker-word";
      for (const char of segment) {
        const letter = document.createElement("span");
        letter.className = "flicker-letter";
        letter.textContent = char;
        letter.style.setProperty("--flicker-delay", `${(Math.random() * 4).toFixed(2)}s`);
        letter.style.setProperty("--flicker-duration", `${(2.2 + Math.random() * 2.2).toFixed(2)}s`);
        word.append(letter);
      }
      decorative.append(word);
    }

    el.replaceChildren(accessibleText, decorative);
  }

  function flickerizeAll() {
    flickerize(document.querySelector<HTMLParagraphElement>("p.lead"));
    flickerize(document.querySelector<HTMLParagraphElement>("p.course-label"));
  }

  flickerizeAll();
  document.addEventListener("astro:page-load", flickerizeAll);
</script>

<style>
  /* ContentLayout renders `description` as `.lead`, a plain <p> whose
     default white-space collapses the newline in the string above --- this
     page's description is the only one on the site meant to render as two
     lines, so pre-line is scoped here rather than on the shared .lead rule. */
  :global(.lead) {
    white-space: pre-line;
  }

  /* Stage-light flicker: each letter is a separate inline-block so its own
     randomized delay/duration (set inline by the script) can drift in and
     out of phase with its neighbours, giving an arbitrary, never-synchronised
     blink rather than a uniform pulse. Gated on prefers-reduced-motion so the
     text itself --- unchanged by this rule --- is all a reduced-motion user
     ever sees; the JS still runs for them, it just never visibly animates. */
  :global(.lead .flicker-word) {
    display: inline-block;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.lead .flicker-letter) {
      display: inline-block;
      animation: lead-flicker-light var(--flicker-duration, 3s) ease-in-out var(--flicker-delay, 0s) infinite;
    }

    /* Dark mode swaps to a keyframe set that also animates text-shadow (see
       below) --- kept as a separate @keyframes rather than a shared one with
       light-dark() shadow colors, because animating a shadow list between
       "none" (light mode's peak) and a populated list (dark mode's peak) asks
       the browser to interpolate lists of different lengths, which several
       engines resolve with a discrete snap partway *through* the transition
       instead of exactly at the keyframe boundary --- a stray in-between
       frame can then paint a half-applied blur even though the value at the
       keyframe stop itself is clean. Giving each mode its own keyframes means
       light mode's never mentions text-shadow at all, so there's nothing for
       any engine to interpolate and no smear is possible regardless of how
       it handles mismatched shadow lists. */
    :global([data-theme="dark"] .lead .flicker-letter) {
      animation-name: lead-flicker-dark;
    }
  }

  @keyframes lead-flicker-light {
    0%,
    40%,
    100% {
      color: var(--at-text-muted);
      font-weight: 400;
    }
    50% {
      color: var(--at-text);
      font-weight: 700;
    }
  }

  @keyframes lead-flicker-dark {
    0%,
    40%,
    100% {
      color: var(--at-text-muted);
      text-shadow: none;
      font-weight: 400;
    }
    50% {
      color: var(--at-text);
      /* The glow reads as a lit stage light against dark mode's near-black
         --at-bg; kept dark-mode-only per the note above. */
      text-shadow:
        0 0 6px var(--at-text),
        0 0 18px var(--at-primary),
        0 0 32px var(--at-primary);
      font-weight: 700;
    }
  }

  .course-label {
    margin-block: 0 1rem;
    color: var(--at-text-secondary);
    font-weight: 600;
  }

  /* Same per-letter flicker mechanism and same animated properties as
     .lead above (shared flicker-word / flicker-letter markup, color +
     font-weight, plus a dark-mode-only text-shadow, split across light/dark
     keyframes for the same reason .lead's are split --- see the note on
     lead-flicker-dark) --- just at lower contrast: the peak font-weight and
     the dark-mode glow are both dialled back from .lead's, instead of
     dropping those dimensions entirely (an earlier version here animated
     color only, which measured as running correctly but read as static at
     a glance --- weight and glow are what make a flicker actually visible,
     not just the color swing). */
  :global(.course-label .flicker-word) {
    display: inline-block;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.course-label .flicker-letter) {
      display: inline-block;
      animation: course-label-flicker-light var(--flicker-duration, 3s) ease-in-out var(--flicker-delay, 0s) infinite;
    }

    :global([data-theme="dark"] .course-label .flicker-letter) {
      animation-name: course-label-flicker-dark;
    }
  }

  @keyframes course-label-flicker-light {
    0%,
    40%,
    100% {
      color: var(--at-text-muted);
      font-weight: 400;
    }
    50% {
      /* Further back from .lead's full-opacity peak --- 65% of the way
         from muted to solid text now, not 85%. */
      color: color-mix(in oklab, var(--at-text) 65%, var(--at-text-muted));
      font-weight: 500;
    }
  }

  @keyframes course-label-flicker-dark {
    0%,
    40%,
    100% {
      color: var(--at-text-muted);
      text-shadow: none;
      font-weight: 400;
    }
    50% {
      color: color-mix(in oklab, var(--at-text) 65%, var(--at-text-muted));
      /* Smaller blur radii and lower glow opacity again. */
      text-shadow:
        0 0 2px var(--at-text),
        0 0 5px rgb(from var(--at-primary) r g b / 30%),
        0 0 9px rgb(from var(--at-primary) r g b / 30%);
      font-weight: 500;
    }
  }

  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }

  .hero-lead {
    font-size: 1.15rem;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block: 1.5rem;
  }

  .table-wrap {
    overflow-x: auto;
  }

  .intro-grid {
    display: grid;
    gap: 2rem;
    margin-block: 2rem;
  }

  @media (min-width: 60rem) {
    .intro-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .week-grid {
    display: grid;
    gap: 1rem;
    margin-block: 1rem 2rem;
  }

  @media (min-width: 60rem) {
    .week-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .week-card {
    border: 1px solid var(--at-border, currentColor);
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
  }

  .week-card h4 {
    margin-block-start: 0;
    color: #fff;
    text-shadow: 0 1px 3px rgb(0 0 0 / 0.6);
  }

  .week-card p {
    margin-block: 0.5rem;
  }

  .week-card__label {
    font-weight: 600;
  }

  .mid-break {
    grid-column: 1 / -1;
    padding: 1rem 1.25rem;
    border: 1px dashed var(--at-border, currentColor);
    border-radius: 0.5rem;
  }

  /* A light, decorative photo behind each week card's text, one per project
     stage (set as the --card-bg-image custom property on the surrounding
     .week-grid in the markup above, which this inherits down to every
     .week-card in that group --- no per-card prop needed). .week-card gets
     its own stacking context via position: relative so the pseudo-element's
     z-index: -1 paints it above the card's own background-color but below
     the in-flow heading/paragraph text, the same ordering already relied on
     for the theme's own .at-card below. Kept at a moderate opacity so the
     photo is clearly visible as a backdrop without ever competing with the
     card's own text --- checked against the automated contrast check in
     `pnpm check`. */
  .week-card {
    position: relative;
    overflow: hidden;
  }

  .week-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: var(--card-bg-image);
    background-size: cover;
    background-position: center;
    opacity: 0.28;
  }

  /* Same treatment for the three project-stage cards above, one photo per
     stage. Card.astro forwards only `href` onto its rendered <a
     class="at-card">, not class/style/data-*, so the stage is identified by
     matching the stable, base-path-safe assessment slug at the end of the
     href (see src/data/weekly-schedule.ts's `href: `/assessments/${id}/``)
     rather than DOM position or an added prop. :global() is required here
     for the same reason as the hero-image rule below: .at-card is rendered
     inside the imported Card component, not authored in this file's own
     template, so Astro's per-file style scoping never reaches it.
     The --stageNBgImage values come from a plain inline style attribute on
     the <div> this file wraps around that <CardGrid> (not a scoped <style>
     define:vars, which only ever lands on the first real element *inside*
     this file's own template --- a sibling of the CardGrid here, not an
     ancestor, so it wouldn't inherit into the grid's Card-rendered
     children). A genuine ancestor div makes the custom-property inheritance
     that :global() then reads actually work. */
  :global(.at-card[href$="/assessments/project-1/"]) {
    position: relative;
    overflow: hidden;
  }
  :global(.at-card[href$="/assessments/project-2/"]) {
    position: relative;
    overflow: hidden;
  }
  :global(.at-card[href$="/assessments/project-3/"]) {
    position: relative;
