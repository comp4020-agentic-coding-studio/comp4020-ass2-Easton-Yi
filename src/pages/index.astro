---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import heroImage from "../assets/images/hero-home.avif";
import { courseMeta } from "../course-config";
import { siteConfig } from "../site-config";
import { getWeeklySchedule } from "../data/weekly-schedule";
import { formatCourseDeadline, formatWeekBeginning } from "../lib/dates";

const { weeks, projects } = await getWeeklySchedule();

// Home-only editorial framing for each project stage, approved verbatim from
// the "The course in three stages" section of docs/CONTENT_SOURCE.md. Weekly
// facts (lecture/session/deadline) come from the shared weekly-schedule
// registry above; this is prose that has no equivalent in a content
// collection, so it stays local to the page that renders it.
const stageCopy: Record<1 | 2 | 3, { heading: string; purpose: string }> = {
  1: {
    heading: "1. Build language ability",
    purpose:
      "Pre-train a decoder-only Transformer on a supplied narrative corpus. Decide how model " +
      "capacity, tokenization, data, optimisation, and runtime fit together under a " +
      "32M-parameter design target.",
  },
  2: {
    heading: "2. Shape model behaviour",
    purpose:
      "Start from a narrative checkpoint and give the model a recognisable voice. Compare " +
      "continued pre-training, supervised instruction tuning, preference-based methods, or a " +
      "justified combination without hiding regressions behind one improved metric.",
  },
  3: {
    heading: "3. Build a specialist",
    purpose:
      "Adapt a permitted checkpoint for one measurable function. Choose a bounded narrative " +
      "capability or arithmetic reasoning, test generalisation, and determine what the " +
      "intervention changed as well as what it damaged.",
  },
};

const weekGroups = [
  { stage: 1 as const, label: "Weeks 1–4", weeks: weeks.slice(0, 4) },
  { stage: 2 as const, label: "Weeks 5–8", weeks: weeks.slice(4, 8) },
  { stage: 3 as const, label: "Weeks 9–12", weeks: weeks.slice(8, 12) },
];
---

<ContentLayout
  title={courseMeta.title}
  description="Frontier practice through budgeted 32M-scale experiments."
  heroImage={heroImage}
  heroImageAlt="An original schematic diagram: a stack of token blocks feeds into a 32M-parameter model box, which produces a bar chart of next-token probabilities, above the course code SLOP4225 and its title."
  {...siteConfig}
>
  <p class="course-label">{courseMeta.code} · {courseMeta.session}, {courseMeta.year}</p>

  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <p class="hero-lead">
    Most language-model courses begin after the expensive decisions have
    already been made. This course begins before the first training token.
    You will choose how to spend a limited model and compute budget, build a
    narrative language model from scratch, reshape its behaviour through
    post-training, and adapt it for one bounded specialist task.
  </p>
  <p>
    The objective is not to imitate a frontier model at miniature scale. It
    is to learn which claims survive contact with limited parameters,
    limited data, limited compute, and evidence you must be able to defend.
  </p>

  <div class="intro-grid">
    <section>
      <h2>What you will do</h2>
      <p>
        Work through three connected projects that follow the life of a language model. You will
        pre-train a narrative model from scratch, reshape its behaviour through post-training, and
        adapt a permitted checkpoint for one specialist capability. At every stage, you will make
        choices about the model, data, training budget, and evaluation—and use evidence to decide
        whether those choices worked.
      </p>
    </section>
    <section>
      <h2>Who this is for</h2>
      <p>
        This course is for senior undergraduate and postgraduate students who have ever wondered
        what actually happens inside the training run behind a language model, and want to stop
        taking that on faith. It suits anyone who enjoys turning a vague claim about scale, data,
        or alignment into an experiment they can run and defend with evidence, and who would
        rather make one deliberate training decision than run a large search and hope.
      </p>
      <p>
        By the end, you will have trained a real language model of your own from scratch, reshaped
        its behaviour on purpose, and specialised it for a task you chose — and be able to explain,
        with evidence, why each of those choices worked or didn't.
      </p>
      <p>
        You should have completed introductory machine learning and be comfortable with basic
        Python, linear algebra, and probability. Prior experience with PyTorch, GPUs, or training a
        language model is not required — the supported sessions and starter repositories introduce
        the working pipeline before you depend on it in an assessment.
      </p>
    </section>
  </div>

  <h2>The course in three stages</h2>
  <CardGrid columns={3}>
    {
      projects.map((project) => (
        <Card title={stageCopy[project.project].heading} href={project.href} headingLevel="h3">
          <p>{stageCopy[project.project].purpose}</p>
          <p>
            <strong>Project {project.project}:</strong> {project.title.replace(/^Project \d+ — /, "")}
            {" "}· Weeks {project.weeks[0]}–{project.weeks[1]} · {project.weight}% · due{" "}
            {formatCourseDeadline(project.due)}
          </p>
        </Card>
      ))
    }
  </CardGrid>

  <p class="hero-ctas">
    <a class="at-button" href={withBase("/lectures/week-01/")}>Start with Week 1</a>
    <a class="at-button at-button--outline" href={withBase("/assessments/")}>View the three projects</a>
  </p>

  <h2>Your twelve-week path</h2>
  <p>
    Each week connects one lecture, one practical or support session, and the next decision in the
    current project. Open either activity directly and use <strong>this week</strong> as the
    minimum project checkpoint to reach before moving on.
  </p>

  {
    weekGroups.map((group) => (
      <>
        <h3>{group.label}</h3>
        <div class="week-grid">
          {group.weeks.map((entry) => (
            <>
              <article class="week-card">
                <h4>
                  Week {entry.week} · {formatWeekBeginning(entry.weekBeginning)}
                </h4>
                {entry.lecture && (
                  <p>
                    <span class="week-card__label">Lecture:</span>{" "}
                    <a href={withBase(entry.lecture.href)}>{entry.lecture.title}</a>
                  </p>
                )}
                {entry.session && (
                  <p>
                    <span class="week-card__label">{entry.session.typeLabel}:</span>{" "}
                    <a href={withBase(entry.session.href)}>{entry.session.title}</a>
                  </p>
                )}
                {entry.milestone ? (
                  <p>
                    <span class="week-card__label">This week:</span>{" "}
                    <a href={withBase(entry.milestone.href)}>
                      <strong>{entry.actionText}</strong>
                    </a>
                  </p>
                ) : (
                  <p>
                    <span class="week-card__label">This week:</span> {entry.actionText}
                  </p>
                )}
              </article>
              {entry.week === 6 && (
                <p class="mid-break">
                  <strong>Mid-semester break, Monday 5–Sunday 11 April 2027</strong> — no teaching.
                  Preserve logs and checkpoints outside the runtime.
                </p>
              )}
            </>
          ))}
        </div>
      </>
    ))
  }

  <p class="hero-ctas">
    <a class="at-button at-button--outline" href={withBase("/schedule/")}>Open the full schedule</a>
  </p>

  <h2>What you will learn to do</h2>
  <p>By the end of the course, you should be able to:</p>
  <ol>
    <li>
      explain and critically evaluate current language-model architectures,
      data practices, training stages, efficiency techniques, and emerging
      claims;
    </li>
    <li>
      plan model capacity, data, optimisation, compute, time, and evaluation
      as one constrained engineering system;
    </li>
    <li>
      run controlled experiments, inspect quantitative results and
      qualitative failures, and revise a plan when the evidence requires it;
      and
    </li>
    <li>
      transfer ideas from frontier systems into small-scale experiments
      while identifying what may not transfer across scale.
    </li>
  </ol>

  <h2>One budget, not unlimited search</h2>
  <p>
    Every project has a learned-parameter boundary and two cumulative
    compute ceilings. Pilots, ablations, failed training runs, and final
    runs all count. The constraint is part of the subject: strong work
    chooses informative experiments, preserves evidence, and stops when
    another run would not answer a useful question.
  </p>
  <p>
    The course provides working starter repositories, versioned data, Colab
    notebooks, evaluation packs, and course-managed fallback compute. Prior
    experience training an LLM or using a GPU is not required;
    introductory machine learning, basic Python, and willingness to inspect
    PyTorch code are expected.
  </p>

  <h2>Assessment timeline</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">Teaching block</th>
          <th scope="col">Project</th>
          <th scope="col">Weight</th>
          <th scope="col">Deadline</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Weeks 1–4 · Pre-training</td>
          <td>Project 1 — Build a Narrative Base Model</td>
          <td>20%</td>
          <td>Sunday 21 March 2027, 23:59 AET</td>
        </tr>
        <tr>
          <td>Weeks 5–8 · Post-training</td>
          <td>Project 2 — Give the Model a Voice</td>
          <td>50%</td>
          <td>Sunday 25 April 2027, 23:59 AET</td>
        </tr>
        <tr>
          <td>Weeks 9–12 · Specialisation</td>
          <td>Project 3 — Build a Specialist</td>
          <td>30%</td>
          <td>Sunday 23 May 2027, 23:59 AET</td>
        </tr>
        <tr>
          <td></td>
          <td><strong>Total</strong></td>
          <td><strong>100%</strong></td>
          <td></td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2>How the course works</h2>
  <ul>
    <li><strong>Lectures</strong> connect mechanisms, public evidence, and the decisions students must make at 32M scale.</li>
    <li>
      <strong>Labs</strong> run in Weeks 2, 6, and 10. Each turns a central
      mechanism into a bounded, carefully supported exercise: read it, run
      it, inspect it, change one thing, and transfer the result into the
      current project.
    </li>
    <li>
      <strong>Drop-in clinics</strong> run in Weeks 3, 7, and 11. Bring
      evidence from your own project: a configuration, curve, comparison,
      output pair, failed command, or proposed claim. Clinics help you
      diagnose and decide; they do not choose an assessed method for you.
    </li>
    <li>
      <strong>Guided sessions</strong> run in the remaining six teaching
      weeks. These short launch, validation, evaluation, and packaging
      activities connect the lecture, lab, and project without creating
      extra graded work.
    </li>
    <li>
      <strong>Projects</strong> assess the resulting engineering judgement
      through a reproducible report and a frozen submitted checkpoint.
    </li>
    <li>
      <strong>Frontier Notes</strong> occasionally introduce a relevant new
      paper or model report. They are optional and are never silently added
      to assessed prerequisite knowledge.
    </li>
  </ul>

  <h2>Where to go next</h2>
  <p>
    Training begins with the target, not the training loop. In Week 1, you
    will turn story text into token targets and make the first decision
    that affects every later result.
  </p>
  <p class="hero-ctas">
    <a class="at-button" href={withBase("/lectures/week-01/")}>Open Week 1 — What a Language Model Learns</a>
  </p>
  <CardGrid columns={3}>
    <Card title="Schedule" href="/schedule/">
      <p>One chronological view of lectures, weekly sessions, and project milestones.</p>
    </Card>
    <Card title="Assessments" href="/assessments/">
      <p>The three project briefs, rubrics, resources, and due dates.</p>
    </Card>
    <Card title="Policies" href="/policies/">
      <p>Rules covering compute, data, evaluation, submission, support, and privacy.</p>
    </Card>
  </CardGrid>
</ContentLayout>

<style>
  .course-label {
    margin-block: 0 1rem;
    color: var(--at-text-secondary);
    font-weight: 600;
  }

  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }

  .hero-lead {
    font-size: 1.15rem;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block: 1.5rem;
  }

  .table-wrap {
    overflow-x: auto;
  }

  .intro-grid {
    display: grid;
    gap: 2rem;
    margin-block: 2rem;
  }

  @media (min-width: 60rem) {
    .intro-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .week-grid {
    display: grid;
    gap: 1rem;
    margin-block: 1rem 2rem;
  }

  @media (min-width: 60rem) {
    .week-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .week-card {
    border: 1px solid var(--at-border, currentColor);
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
  }

  .week-card h4 {
    margin-block-start: 0;
  }

  .week-card p {
    margin-block: 0.5rem;
  }

  .week-card__label {
    font-weight: 600;
  }

  .mid-break {
    grid-column: 1 / -1;
    padding: 1rem 1.25rem;
    border: 1px dashed var(--at-border, currentColor);
    border-radius: 0.5rem;
  }

  /* hero-home.avif bakes in a retired working subtitle ("Training Language
     Models: A Budgeted Engineering Task") as part of the illustration itself
     (not DOM text; the "SLOP4225" caption above it has been erased from the
     asset). The theme's hero band is very wide and short relative to the
     16:9 source, so object-fit: cover's default centred position crops that
     region out of view. object-position: 20% 43% clears the vertical crop
     window across widths from 390px to 1920px (checked in 20px steps
     through the 1400-1920px band, where the hero's height itself jumps
     partway through --- the <h1> box nearly fills the hero there, leaving
     almost no clearance) without ever letting the subtitle's bottom edge
     collide with the title's first glyph row, and with a comfortable margin
     above the single razor-thin point (39%) that a strict never-collide scan
     found for that band. Narrower breakpoints have much wider tolerance;
     this value is only load-bearing in the 1400-1920px range. Matched by the
     resolved image src rather than the theme's shared .at-hero-image class,
     so this doesn't shift the People-page or 404 hero photos, which reuse
     that class too. */
  :global(img[src*="hero-home"].at-hero-image) {
    object-position: 20% 43%;
  }
</style>
