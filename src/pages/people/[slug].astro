---
import { Image } from "astro:assets";
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const people = await getPublishedCollection("people");
  return people.map((person) => ({ params: { slug: person.id }, props: { person } }));
}

const { person } = Astro.props;
const { Content } = await render(person);

// Map the role enum (convenor|tutor|compute-steward|guest|other) to display
// labels rather than rendering the raw lowercase value.
const roleLabels: Record<string, string> = {
  convenor: "Course Convenor and Lecturer",
  tutor: "Teaching Fellow and Technical Tutor",
  "compute-steward": "Compute Steward",
  guest: "Guest lecturer",
  other: "",
};
const roleLabel = person.data.role ? roleLabels[person.data.role] : undefined;
// Astro's generated type does not retain the image/alt refinement relationship,
// so narrow the alt at the rendering boundary as well.
const rawPhotoAlt = (person.data as { photoAlt?: unknown }).photoAlt;
const photoAlt = typeof rawPhotoAlt === "string" ? rawPhotoAlt : "";
// Every page owes a description --- it is what a search result and a shared
// link show underneath the title.
const description = person.data.description;
---

<ContentLayout title={person.data.title} description={description} {...siteConfig}>
  {
    person.data.photo && (
      <Image
        src={person.data.photo}
        alt={photoAlt}
        width={192}
        height={192}
        densities={[1, 2]}
        class="person-avatar"
      />
    )
  }
  <dl>
    {roleLabel && (
      <>
        <dt>Role</dt>
        <dd>{roleLabel}</dd>
      </>
    )}
    {person.data.affiliation && (
      <>
        <dt>Affiliation</dt>
        <dd>{person.data.affiliation}</dd>
      </>
    )}
    {person.data.email && (
      <>
        <dt>Email</dt>
        <dd>
          <a href={`mailto:${person.data.email}`}>{person.data.email}</a>
        </dd>
      </>
    )}
    {person.data.url && (
      <>
        <dt>Web</dt>
        <dd>
          <a href={person.data.url}>{person.data.url}</a>
        </dd>
      </>
    )}
    <dt>Contact</dt>
    <dd>{person.data.contact}</dd>
  </dl>

  <Content />
</ContentLayout>

<style>
  /* The people collection's `photo` is a portrait headshot, not a wide
     banner --- ContentLayout's Hero is built for the latter (a full-bleed,
     very wide/short band; see the object-position tuning on hero-home in
     src/pages/index.astro) and crops a square headshot down to an unusable
     close-up of the nose and mouth. Rendered as a plain, circular in-body
     image instead --- the same treatment PeopleGrid.astro uses for the card
     thumbnail on /people/, so a person's photo looks the same avatar shape
     everywhere it appears. */
  .person-avatar {
    display: block;
    width: 12rem;
    height: 12rem;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 50%;
    margin-block-end: var(--at-spacing-lg);
    outline: 1px solid rgb(0 0 0 / 8%);
    outline-offset: -1px;
  }
</style>
