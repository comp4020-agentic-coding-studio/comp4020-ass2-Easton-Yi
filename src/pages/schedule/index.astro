---
import { getPublishedCollection } from "astro-course-university/content";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import { formatCourseDateTime, formatWeekBeginning } from "../../lib/dates";
import { courseMeta } from "../../course-config";
import { sessionLabels, siteConfig } from "../../site-config";

const lectures = await getPublishedCollection("lectures");
const sessions = await getPublishedCollection("sessions");
const assessments = await getPublishedCollection("assessments");

const lecturesByWeek = new Map(lectures.map((lecture) => [lecture.data.week, lecture]));
const sessionsByWeek = new Map(sessions.map((session) => [session.data.week, session]));
const assessmentsByWeek = new Map(assessments.map((assessment) => [assessment.data.week, assessment]));

const sessionTypeLabels = {
  guided: "Guided session",
  lab: "Formal lab",
  clinic: "Drop-in clinic",
} as const;

// Short milestone copy per week, approved wording from the Schedule-page
// table in CONTENT_SOURCE.md. Weeks with a project due read their date
// straight from the assessments collection rather than repeating it here.
const milestoneText: Record<number, string> = {
  1: "Project 1 released; validate data and define the target",
  2: "Freeze a feasible baseline architecture",
  3: "Freeze the principal run plan",
  5: "Project 2 opens; define the target voice and baseline",
  6: "Produce a masking check and viable pilot",
  7: "Freeze the evaluation comparison",
  9: "Project 3 opens; proposal due 2 May for alternative Track A tasks",
  10: "Produce one loadable pilot and valid metric",
  11: "Freeze the candidate checkpoint and bounded claim",
};

const weeks = Array.from({ length: 12 }, (_, i) => i + 1);
---

<ContentLayout
  title="Schedule"
  description={`One chronological view of the ${courseMeta.session}, ${courseMeta.year} teaching period: lectures, weekly ${sessionLabels.singular.toLowerCase()} sessions, project milestones, and the break.`}
  {...siteConfig}
>
  <p>
    Twelve teaching weeks, each pairing one lecture with one weekly{" "}
    {sessionLabels.singular.toLowerCase()} session --- a formal
    lab, a drop-in clinic, or a lightweight guided session. The
    mid-semester break falls after Week 6, and each project is due at the
    end of its four-week block.
  </p>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">Week</th>
          <th scope="col">Week beginning</th>
          <th scope="col">Lecture</th>
          <th scope="col">{sessionLabels.singular}</th>
          <th scope="col">Milestone</th>
        </tr>
      </thead>
      <tbody>
        {
          weeks.map((week) => {
            const lecture = lecturesByWeek.get(week);
            const session = sessionsByWeek.get(week);
            const assessment = assessmentsByWeek.get(week);
            return (
              <>
                <tr>
                  <td>{week}</td>
                  <td>{lecture && formatWeekBeginning(lecture.data.date)}</td>
                  <td>
                    {lecture && (
                      <a href={withBase(`/lectures/${lecture.id}/`)}>{lecture.data.title}</a>
                    )}
                  </td>
                  <td>
                    {session && (
                      <>
                        <a href={withBase(`/sessions/${session.id}/`)}>{session.data.title}</a>
                        {" "}
                        <small>({sessionTypeLabels[session.data.sessionType]})</small>
                      </>
                    )}
                  </td>
                  <td>
                    {assessment ? (
                      <a href={withBase(`/assessments/${assessment.id}/`)}>
                        <strong>
                          Project {assessment.data.project} due{" "}
                          {formatCourseDateTime(assessment.data.due)}
                        </strong>
                      </a>
                    ) : (
                      milestoneText[week]
                    )}
                  </td>
                </tr>
                {week === 6 && (
                  <tr>
                    <td>&mdash;</td>
                    <td>5 April</td>
                    <td colspan="2">
                      <strong>Mid-semester break, Monday 5&ndash;Sunday 11 April 2027</strong> ---
                      no teaching
                    </td>
                    <td>Preserve logs and checkpoints outside the runtime</td>
                  </tr>
                )}
              </>
            );
          })
        }
      </tbody>
    </table>
  </div>
</ContentLayout>

<style>
  .table-wrap {
    overflow-x: auto;
  }
</style>
