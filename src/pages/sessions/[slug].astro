---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import SpecList from "astro-course-university/components/SpecList.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import SequenceNav from "../../components/SequenceNav.astro";
import TeachingTeam from "../../components/TeachingTeam.astro";
import { formatCourseDate } from "../../lib/dates";
import { graphCollections, siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const sessions = await getPublishedCollection("sessions");
  const sorted = sessions.slice().sort((a, b) => a.data.week - b.data.week);
  return sorted.map((session, i) => ({
    params: { slug: session.id },
    props: { session, prevSession: sorted[i - 1], nextSession: sorted[i + 1] },
  }));
}

const { session, prevSession, nextSession } = Astro.props;
const { Content } = await render(session);

const sessionTypeLabels = {
  guided: "Guided session",
  lab: "Formal lab",
  clinic: "Drop-in clinic",
} as const;

const prevLink = prevSession && { href: `/sessions/${prevSession.id}/`, label: `Week ${prevSession.data.week}` };
const nextLink = nextSession && { href: `/sessions/${nextSession.id}/`, label: `Week ${nextSession.data.week}` };
---

<ContentLayout
  title={`Week ${session.data.week} ${sessionTypeLabels[session.data.sessionType]}: ${session.data.title}`}
  description={session.data.description}
  {...siteConfig}
>
  <p>
    <strong>{formatCourseDate(session.data.date)}</strong> ·{" "}
    {sessionTypeLabels[session.data.sessionType]}
  </p>
  <Content />
  <SpecList spec={session.data.spec}>
    What you bring to the session. Written so a reader can tell whether it has
    been met without asking you.
  </SpecList>
  <TeachingTeam teachers={session.data.teachers} />
  <RelatedContent entry={session} collections={graphCollections} />
  <SequenceNav prev={prevLink} next={nextLink} ariaLabel="Week navigation" />
</ContentLayout>
