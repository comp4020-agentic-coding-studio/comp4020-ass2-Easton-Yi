---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
---

<ContentLayout
  title={sessionLabels.plural}
  description={`The twelve-week teaching schedule: what happens in each ${sessionLabels.singular.toLowerCase()}, what to prepare, and what leaves the room.`}
  {...siteConfig}
>
  <p>
    Every teaching week pairs its lecture with one weekly session: a{" "}
    <strong>formal lab</strong> in Weeks 2, 6, and 10, turning a central
    mechanism into a bounded, supported exercise; a{" "}
    <strong>drop-in clinic</strong> in Weeks 3, 7, and 11, where you bring
    evidence from your own project for diagnosis; or a{" "}
    <strong>guided session</strong> in the remaining six weeks, a short
    launch, validation, evaluation, or packaging activity that connects the
    lecture and the project without creating extra graded work.
  </p>
  <SessionsGrid />
</ContentLayout>
